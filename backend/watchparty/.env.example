NODE_ENV=development
HOST=127.0.0.1
PORT=8081
DATABASE_URL=postgresql://hambin:local-development-only@127.0.0.1:15432/hambin_watchparty
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set trusted ingress addresses explicitly in production.
TRUSTED_PROXIES=
# Voice is disabled until private TURN URLs and a fresh >=32-byte secret are set.
TURN_URLS=
TURN_SHARED_SECRET=

# Optional automatic errors and durable manual-feedback delivery
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
