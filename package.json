{
  "name": "hambin-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/server.ts",
    "start:hambin": "node server/server.ts",
    "dev": "node --watch-path server server/server.ts",
    "build": "npm run typecheckServer",
    "typecheckServer": "tsc --project server/tsconfig.json",
    "test:backend": "node --test server/hambin/tests/*.test.ts",
    "test:integration": "HAMBIN_INTEGRATION=true node --test --test-concurrency=1 server/hambin/tests/*.integration.test.ts server/hambin/tests/integration.test.ts"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.1",
    "@types/pg": "^8.16.0",
    "typescript": "^5.9.3",
    "socket.io-client": "^4.8.1"
  },
  "engines": {
    "node": "24.18.x",
    "npm": "11.16.x"
  },
  "packageManager": "npm@11.16.0"
}
